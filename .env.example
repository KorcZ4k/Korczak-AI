# Backend
APP_ENV=production
MONGODB_URI=
MONGODB_DATABASE=KorczakControl
MONGODB_COLLECTION=Users
MONGODB_CHATS_COLLECTION=Chats
SECRET_KEY=
OLLAMA_BASE_URL=
MODEL=qwen2.5:0.5b
MODEL_CONTEXT=8192
MODEL_TEMPERATURE=0.35

# Frontend / security
FRONTEND_ORIGIN=https://YOUR-USERNAME.github.io
AUTH_TOKEN_MAX_AGE=604800
MAX_BODY_BYTES=2097152
LOGIN_RATE_LIMIT=10
CHAT_RATE_LIMIT=20
SEARCH_RATE_LIMIT=30
RATE_WINDOW=60

# Optional web search
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
